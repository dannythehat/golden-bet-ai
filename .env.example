# API-Football Configuration (REQUIRED)
# Get your API key from: https://api-sports.io
# 100k calls/day limit
VITE_API_FOOTBALL_KEY=***REMOVED***

# Odds API (Fallback)
VITE_ODDS_API_KEY=***REMOVED***

# MongoDB Configuration (REQUIRED for stats storage)
MONGODB_URI=***REMOVED***

# Supabase Configuration (Optional - for user features)
VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_SUPABASE_URL=your_supabase_url_here
