# Copy this file to `.env` (which is gitignored) and fill in real values.
# NEVER commit real keys. Set production values in the Vercel dashboard.

# --- Supabase (client) ---
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here
VITE_SUPABASE_PROJECT_ID=your_project_id_here

# --- Stripe / payments (client publishable token: pk_test_… or pk_live_…) ---
VITE_PAYMENTS_CLIENT_TOKEN=your_stripe_publishable_token_here

# --- Optional: football data provider (only if betting/stats features are kept) ---
# VITE_API_FOOTBALL_KEY=your_api_football_key_here
# VITE_ODDS_API_KEY=your_odds_api_key_here
